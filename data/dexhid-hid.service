# DexHid M3: root helper (configfs USB gadget). Started by dexhid-hid.socket; when the user daemon goes away it
# releases every key / button on the far side and removes the gadget.
[Unit]
Description=DexHid HID helper (USB gadget for the tablet-as-keyboard mode)
Requires=dexhid-hid.socket
After=dexhid-hid.socket

[Service]
ExecStart=/usr/bin/dexhid hid-helper
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
