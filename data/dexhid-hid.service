# DexHid M3: root helper (configfs USB gadget, Bluetooth HID profile + L2CAP). Started by dexhid-hid.socket; when
# the user daemon goes away it releases every key / button on the far side and removes the gadget / profile.
[Unit]
Description=DexHid HID helper (USB gadget / Bluetooth HID for the tablet-as-keyboard modes)
Requires=dexhid-hid.socket
After=dexhid-hid.socket bluetooth.service

[Service]
ExecStart=/usr/bin/dexhid hid-helper
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
